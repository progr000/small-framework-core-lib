{
  "name": "maksym/small-framework-core-lib",
  "type": "library",
  "description": "Package framework core lib",
  "keywords": [
    "framework"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Maksym Haivoronskyi",
      "email": "maksym.haivoronskyi@gmail.com"
    }
  ],
  "require": {
    "php": ">=5.6.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-pdo": "*",
    "ext-iconv": "*",
    "ext-openssl": "*",
    "ext-curl": "*",
    "ext-memcached": "*",
    "maksym/config-lib": "@stable",
    "maksym/log-lib": "@stable",
    "maksym/sess-cook-lib": "@stable",
    "maksym/helper-functions": "@stable"
  },
  "require-dev": {
    "phpunit/phpunit": "@stable",
    "mockery/mockery": "*",
    "maksym/dumper": "@stable"
  },
  "suggest": {
    "maksym/db-lib": "Provide lib for work with mysql, sqlite, pgsql, mssql and lib for ActiveRecord",
    "maksym/cache-lib": "Provide lib for caching with different drivers",
    "maksym/wget-lib": "Provide lib for convinient work with curl",
    "maksym/console-lib": "Provide lib for create console command for framework",
    "maksym/sendmail-lib": "Provide lib for sending mail with attachments and sign mail.",
    "maksym/debug-panel": "Provide lib for convinient debug"
  },
  "autoload": {
    "files": [
      "src/functions/helpers.php"
    ],
    "psr-4": {
      "Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
